{
  "version": "v0.151.0",
  "organizationId": "example-organization-id",
  "hostIdentityId": "example-host-identity-id",
  "k8IdentityId": "example-k8-identity-id",
  "createK8Identity": false,
  "include": ["example-project-id"],
  "exclude": [],
  "allProjects": false,
  "apply": false,
  "repairRevocations": false,
  "intervalSeconds": 60,
  "maxProjects": 100,
  "mcpAccess": {
    "contexts": {
      "kubedesk": { "targetProjectId": "example-project-id", "allowCrossProject": false }
    },
    "projects": {
      "example-project-id": {
        "mode": "limited",
        "operations": ["secret.list"],
        "environments": ["dev"],
        "pathPrefixes": ["/app"]
      }
    }
  }
}
