{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kuchdesk:doctor:report:v2",
  "title": "KuchDesk Doctor Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "durationMs", "healthy", "summary", "checks", "findings", "limitations"],
  "properties": {
    "schemaVersion": {"const": "kuchdesk.doctor/v2"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "durationMs": {"type": "integer", "minimum": 0},
    "healthy": {"type": "boolean"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "warnings", "failed"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "checks": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/check"}},
    "findings": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/finding"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component", "status", "message", "source", "context", "observedAt", "durationMs", "truncated"],
      "properties": {
        "id": {"type": "string"},
        "component": {"type": "string"},
        "status": {"enum": ["ok", "warn", "fail"]},
        "message": {"type": "string"},
        "evidence": {"type": "object"},
        "recommendation": {"type": "string"},
        "source": {"type": "string"},
        "context": {"type": "string"},
        "observedAt": {"type": "string", "format": "date-time"},
        "durationMs": {"type": "integer", "minimum": 0},
        "exitCode": {"type": "integer"},
        "errorClass": {"type": "string"},
        "version": {"type": "string"},
        "rawExcerpt": {"type": "string", "maxLength": 512},
        "truncated": {"type": "boolean"},
        "dependencies": {"type": "array", "items": {"type": "string"}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "severity", "problem", "recommendation"],
      "properties": {
        "checkId": {"type": "string"},
        "severity": {"enum": ["warn", "fail"]},
        "problem": {"type": "string"},
        "evidence": {"type": "object"},
        "recommendation": {"type": "string"}
      }
    }
  }
}
