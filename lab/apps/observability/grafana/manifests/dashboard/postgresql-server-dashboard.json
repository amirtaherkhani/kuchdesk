{
  "uid": "kuchdesk-postgresql-server",
  "title": "Platform / PostgreSQL server",
  "tags": ["kuchdesk", "observability", "postgresql"],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": {"from": "now-30m", "to": "now"},
  "refresh": "30s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "PostgreSQL reachable",
      "description": "The dedicated Alloy exporter can connect to the Finance database.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "pg_up{job=\"integrations/postgres\"}", "legendFormat": "PostgreSQL", "range": true}]
    },
    {
      "id": 2,
      "title": "Exporter scrape error",
      "description": "Zero means the latest PostgreSQL exporter scrape completed without an exporter error.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "pg_exporter_last_scrape_error{job=\"integrations/postgres\"}", "legendFormat": "Scrape error", "range": true}]
    },
    {
      "id": 3,
      "title": "Finance connections",
      "description": "Current PostgreSQL backends connected to the Finance database.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "pg_stat_database_numbackends{job=\"integrations/postgres\",datname=\"finance\"}", "legendFormat": "Connections", "range": true}]
    },
    {
      "id": 4,
      "title": "Finance database size",
      "description": "Current size of the Finance database.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "pg_database_size_bytes{job=\"integrations/postgres\",datname=\"finance\"}", "legendFormat": "Database size", "range": true}]
    },
    {
      "id": 5,
      "title": "Finance transactions per second",
      "description": "Commit and rollback rates from PostgreSQL database statistics; no traffic is generated by this panel.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "rate(pg_stat_database_xact_commit{job=\"integrations/postgres\",datname=\"finance\"}[5m])", "legendFormat": "Commits/s", "range": true},
        {"refId": "B", "expr": "rate(pg_stat_database_xact_rollback{job=\"integrations/postgres\",datname=\"finance\"}[5m])", "legendFormat": "Rollbacks/s", "range": true}
      ]
    },
    {
      "id": 6,
      "title": "Public table tuple estimates",
      "description": "Aggregated live and dead tuple estimates for Finance public tables, without table-level labels or row contents.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum(pg_stat_user_tables_n_live_tup{job=\"integrations/postgres\",datname=\"finance\",schemaname=\"public\"})", "legendFormat": "Live tuples", "range": true},
        {"refId": "B", "expr": "sum(pg_stat_user_tables_n_dead_tup{job=\"integrations/postgres\",datname=\"finance\",schemaname=\"public\"})", "legendFormat": "Dead tuples", "range": true}
      ]
    }
  ]
}
