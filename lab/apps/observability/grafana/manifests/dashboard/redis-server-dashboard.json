{
  "uid": "kuchdesk-redis-server",
  "title": "Platform / Redis server",
  "tags": ["kuchdesk", "observability", "redis"],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": {"from": "now-30m", "to": "now"},
  "refresh": "30s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Redis reachable",
      "description": "The dedicated Alloy exporter can authenticate and collect server metrics.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "redis_up{job=\"integrations/redis\"}", "legendFormat": "Redis", "range": true}]
    },
    {
      "id": 2,
      "title": "Exporter scrape error",
      "description": "Zero means the latest Redis exporter scrape completed without an exporter error.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "redis_exporter_last_scrape_error{job=\"integrations/redis\"}", "legendFormat": "Scrape error", "range": true}]
    },
    {
      "id": 3,
      "title": "Redis memory used",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "redis_memory_used_bytes{job=\"integrations/redis\"}", "legendFormat": "Used memory", "range": true}]
    },
    {
      "id": 4,
      "title": "Connected clients",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "redis_connected_clients{job=\"integrations/redis\"}", "legendFormat": "Clients", "range": true}]
    }
  ]
}
